# Copy to .env.local and edit. Everything site-identifying lives here.
# These are read in src/config/site.ts.

NEXT_PUBLIC_SITE_NAME="Crypto Brief"
NEXT_PUBLIC_SITE_DESCRIPTION="A blog about cryptocurrency."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. The price ticker works without this, but CoinGecko's keyless tier
# throttles aggressively — a free "Demo" key from coingecko.com/en/api raises
# the ceiling and lets you lower `revalidate` in src/app/api/ticker/route.ts.
# Server-side only: do NOT prefix with NEXT_PUBLIC_.
COINGECKO_API_KEY=""
